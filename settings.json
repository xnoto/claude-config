{
  "editorMode": "vim",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "MCP_TIMEOUT": "10000"
  },
  "permissions": {
    "allow": [
      "Bash(ssh:*)",
      "WebSearch",
      "WebFetch(domain:dlcdnets.asus.com)",
      "mcp__parallel-search__*"
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "context-mode@context-mode": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem",
        "ref": "v13.24.20"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode",
        "ref": "v1.0.169"
      }
    }
  }
}
