{
  "mcpServers": {
    "context-mode": {
      "command": "context-mode",
      "args": []
    },
    "parallel-search": {
      "type": "http",
      "url": "https://mcp-parallel-search.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "aws-staging": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "timeout": 100000
    },
    "aws-prod": {
      "type": "http",
      "url": "http://127.0.0.1:8766/mcp",
      "timeout": 100000
    },
    "aws-docs": {
      "type": "http",
      "url": "https://mcp-aws-docs.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "grafana": {
      "type": "http",
      "url": "http://127.0.0.1:8768/mcp"
    },
    "agent-hub": {
      "type": "http",
      "url": "http://127.0.0.1:8776/mcp"
    },
    "tmux": {
      "type": "http",
      "url": "http://127.0.0.1:8770/mcp"
    },
    "terraform-docs": {
      "type": "http",
      "url": "https://mcp-terraform-docs.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "opentofu-docs": {
      "type": "http",
      "url": "https://mcp.opentofu.org/mcp"
    },
    "opencode-docs": {
      "type": "http",
      "url": "http://127.0.0.1:8773/mcp"
    },
    "argocd-staging-eks": {
      "type": "http",
      "url": "http://127.0.0.1:8774/mcp"
    },
    "argocd-prod-eks": {
      "type": "http",
      "url": "http://127.0.0.1:8775/mcp"
    },
    "argocd-makeitwork": {
      "type": "http",
      "url": "https://mcp-argocd-makeitwork.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "apify": {
      "type": "http",
      "url": "https://mcp-apify.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp-context7.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://mcp-github.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "kubernetes": {
      "type": "http",
      "url": "https://mcp-kubernetes.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "grafana-makeitwork": {
      "type": "http",
      "url": "https://mcp-grafana-makeitwork.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    }
  }
}
