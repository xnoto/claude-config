{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "aws-staging": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile", "staging",
        "--read-only",
        "--metadata", "AWS_REGION=us-east-2"
      ],
      "timeout": 100000
    },
    "aws-prod": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile", "prod",
        "--read-only",
        "--metadata", "AWS_REGION=us-east-2"
      ],
      "timeout": 100000
    },
    "aws-docs": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_DOCUMENTATION_PARTITION": "aws"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "grafana": {
      "command": "uvx",
      "args": ["mcp-grafana@1.0.0"],
      "env": {
        "GRAFANA_URL": "https://hatchengineering.grafana.net",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_TOKEN}"
      }
    },
    "agent-hub": {
      "command": "npx",
      "args": ["-y", "agent-hub-mcp@latest"]
    },
    "tmux": {
      "command": "npx",
      "args": ["-y", "tmux-mcp"]
    },
    "terraform-docs": {
      "command": "podman",
      "args": ["run", "--rm", "-i", "docker.io/hashicorp/terraform-mcp-server:1.1.0"]
    },
    "opentofu-docs": {
      "type": "http",
      "url": "https://mcp.opentofu.org/mcp"
    },
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes"],
      "env": {
        "K8S_CONTEXT": "staging-eks.angler-elver.ts.net"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "argocd-staging-eks": {
      "command": "npx",
      "args": ["-y", "argocd-mcp@latest", "stdio"],
      "env": {
        "ARGOCD_BASE_URL": "https://argocd-staging.angler-elver.ts.net",
        "ARGOCD_API_TOKEN": "${ARGOCD_STAGING_TOKEN}"
      }
    },
    "argocd-prod-eks": {
      "command": "npx",
      "args": ["-y", "argocd-mcp@latest", "stdio"],
      "env": {
        "ARGOCD_BASE_URL": "https://argocd-prod.angler-elver.ts.net",
        "ARGOCD_API_TOKEN": "${ARGOCD_PROD_TOKEN}"
      }
    }
  }
}
