{
  "mcpServers": {
    "context-mode": {
      "command": "context-mode",
      "args": []
    },
    "parallel-search": {
      "type": "http",
      "url": "http://127.0.0.1:8782/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "aws-staging": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "timeout": 100000
    },
    "aws-prod": {
      "type": "http",
      "url": "http://127.0.0.1:8766/mcp",
      "timeout": 100000
    },
    "aws-docs": {
      "type": "http",
      "url": "http://127.0.0.1:8767/mcp"
    },
    "mcp-gateway": {
      "type": "http",
      "url": "https://mcp.makeitwork.cloud/mcp",
      "headers": {
        "CF-Access-Client-Id": "${CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "${CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "grafana": {
      "type": "http",
      "url": "http://127.0.0.1:8768/mcp"
    },
    "agent-hub": {
      "type": "http",
      "url": "http://127.0.0.1:8776/mcp"
    },
    "tmux": {
      "type": "http",
      "url": "http://127.0.0.1:8770/mcp"
    },
    "terraform-docs": {
      "type": "http",
      "url": "http://127.0.0.1:8771/mcp"
    },
    "opentofu-docs": {
      "type": "http",
      "url": "https://mcp.opentofu.org/mcp"
    },
    "opencode-docs": {
      "type": "http",
      "url": "http://127.0.0.1:8773/mcp"
    },
    "argocd-staging-eks": {
      "type": "http",
      "url": "http://127.0.0.1:8774/mcp"
    },
    "argocd-prod-eks": {
      "type": "http",
      "url": "http://127.0.0.1:8775/mcp"
    },
    "argocd-makeitwork": {
      "type": "http",
      "url": "http://127.0.0.1:8777/mcp"
    },
    "apify": {
      "type": "http",
      "url": "http://127.0.0.1:8783/mcp"
    },
    "linkedin": {
      "command": "uvx",
      "args": ["mcp-server-linkedin@latest"],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    }
  }
}
